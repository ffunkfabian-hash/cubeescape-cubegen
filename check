#!/bin/sh
# Thin wrapper: ./check = quick checks, ./check --full = full suite (commands: .ce-repo.json > check).
# Runs the shared tools pinned in .ce-repo.json > tools_version through the loader ./ce (no embedded copy).
d=$(cd "$(dirname "$0")" && pwd)
mode=check
[ "$1" = "--full" ] && { mode="check --full"; shift; }
exec "$d/ce" $mode "$@"
