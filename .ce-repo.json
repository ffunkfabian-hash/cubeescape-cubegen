{
  "name": "cubegen",
  "version": {
    "file": "cubegen/__init__.py",
    "pattern": "__version__\\s*=\\s*\"([^\"]+)\""
  },
  "check": {
    "quick": [
      [
        "python3",
        "tools/run_tests.py",
        "--tier",
        "quick"
      ]
    ],
    "full": [
      [
        "python3",
        "tools/run_tests.py",
        "--tier",
        "full"
      ]
    ],
    "nightly": [
      [
        "./ce",
        "lock",
        "gpu",
        "--",
        "python3",
        "tools/run_tests.py",
        "--tier",
        "full"
      ]
    ]
  },
  "docs": {
    "versions": "docs/versions",
    "archive": "docs/archive/versions",
    "changelog": "CHANGELOG.md",
    "decisions": "docs/ENTSCHEIDUNGEN.md"
  },
  "limits": {
    "AGENTS.md": 150,
    "CLAUDE.md": 20
  },
  "release": {
    "branch_prefix": "release/",
    "tag_prefix": "v"
  },
  "heavy_lock": true,
  "coordination": {
    "repo": "ffunkfabian-hash/cubeescape-nexogen",
    "registry": "https://github.com/ffunkfabian-hash/cubeescape-nexogen/blob/main/repos.json"
  },
  "tools_version": {
    "version": "0.35.0",
    "commit": "79250432f2d2cedeab642800c6a2ac667e6ec645"
  },
  "tidy": {
    "paths": [
      {
        "name": "Erzeugte Seeds output/seed_*",
        "root": "output",
        "glob": "seed_*",
        "keep": 2,
        "older_than_days": 14
      },
      {
        "name": "Vision-Prüfbau output/tools/vision_check_*",
        "root": "output/tools",
        "glob": "vision_check_*",
        "keep": 1,
        "older_than_days": 14
      }
    ]
  },
  "core_paths": [
    "cubegen/contract.json",
    "cubegen/contract.py",
    "cubegen/migrate.py",
    "cubegen/pipeline.py"
  ]
}
